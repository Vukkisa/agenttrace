{
  "name": "@vukkisa/agenttrace",
  "version": "0.3.1",
  "description": "Local-first CLI that analyzes Claude Code and Codex session logs: tokens, API-equivalent cost, time, failed tool calls, repeated failures and possible loops. Offline, no LLM, no telemetry.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vukkisa/agenttrace.git"
  },
  "homepage": "https://github.com/Vukkisa/agenttrace#readme",
  "bugs": {
    "url": "https://github.com/Vukkisa/agenttrace/issues"
  },
  "type": "module",
  "bin": {
    "agenttrace": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check:package": "node scripts/check-package.mjs",
    "prepack": "npm run build",
    "example": "npm run build && node dist/cli/index.js report --session 11111111 --claude-dir tests/fixtures/claude --codex-dir tests/fixtures/codex --out examples/example-report.html",
    "fixtures": "node tests/fixtures/generate.mjs"
  },
  "keywords": [
    "claude-code",
    "codex",
    "ai-agents",
    "coding-agents",
    "session-logs",
    "observability",
    "tokens",
    "cost",
    "cli"
  ],
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "commander": "^14.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "access": "public"
  }
}
